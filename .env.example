# ─────────────────────────────────────────────────────────────────────────────
# AgentLumy — Modèle de configuration
# Copier en .env puis renseigner. Ne JAMAIS commiter le .env réel.
# La liste fait foi : elle reflète app/config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_NAME=voice-agent-garage
APP_PORT=8080                       # 8080 = compatibilité Cloud Run
APP_BASE_URL=http://localhost:8080  # en dev : URL ngrok (change à chaque redémarrage)
APP_FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ── Tâches planifiées ────────────────────────────────────────────────────────
# Secret partagé avec Cloud Scheduler, exigé par les routes /internal/*.
# Obligatoire en production : ces routes envoient des SMS.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# ── Mode fournisseurs ────────────────────────────────────────────────────────
# real = vrais appels API (nécessite les comptes payants)
# fake = fournisseurs simulés au niveau HTTP (Twilio, Cal.com, Vapi, Resend).
#        Permet de valider tout le produit sans numéro FR, sans plan Cal.com
#        et sans consommer de crédits. Voir app/integrations/fake_transport.py
PROVIDER_MODE=fake

# ── Localisation ─────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Paris
DEFAULT_LOCALE=fr_FR

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # id complet requis côté Vapi

# ── Vapi ─────────────────────────────────────────────────────────────────────
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=                # obligatoire en production (signature HMAC)
VAPI_ASSISTANT_ID=
VAPI_API_BASE_URL=https://api.vapi.ai
# Reglages de l'agent (relever ceux d'un assistant eprouve avec
# scripts/read_vapi_config.py, puis les reporter ici)
VAPI_TEMPERATURE=0.4
VAPI_MAX_TOKENS=250
VAPI_WAIT_SECONDS=0.5        # delai avant prise de parole (startSpeakingPlan)
VAPI_ENABLE_SUMMARY=true     # false = economise un appel LLM, vide le resume

# ── Speech ───────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_FR=
CARTESIA_MODEL=sonic-multilingual

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                # numéro FR dédié (compte payant requis)
TWILIO_MESSAGING_SERVICE_SID=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # utilisé par le backend et le dashboard (bypass RLS)
SUPABASE_DB_PASSWORD=               # uniquement pour scripts/dump_schema.py
# Connexion directe : le host db.<ref>.supabase.co est IPv6 uniquement.
# Sans IPv6, utiliser la chaîne « Session pooler » et renseigner :
# SUPABASE_DB_HOST=
# SUPABASE_DB_USER=
# SUPABASE_DB_PORT=5432

# ── Cal.com ──────────────────────────────────────────────────────────────────
CALCOM_API_KEY=
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_WEBHOOK_SECRET=

# ── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=rdv@agentlumy.com

# ── Google Cloud Run (étape 13) ──────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=europe-west1
GCP_SERVICE_NAME=voice-agent-garage-api
GCP_ARTIFACT_REGISTRY=europe-west1-docker.pkg.dev

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_URGENCY_DETECTION=true
ENABLE_CALL_RECORDING=true          # ⚠️ RGPD : information de l'appelant obligatoire
ENABLE_TRANSCRIPTION_STORAGE=true
MAX_CALL_DURATION_SECONDS=600
